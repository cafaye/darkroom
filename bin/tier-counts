#!/usr/bin/env bash
# bin/tier-counts — did `bin/prime --db` actually run every tier, and how many?
#
#   ./bin/prime --db 2>&1 | tee /tmp/prime.log
#   ./bin/tier-counts /tmp/prime.log
#
# ## Why this exists at all
#
# `bin/prime` exits zero when it is happy, and `cargo test` exits zero when it
# ignored every test it could. Those two facts are the same fact: a green exit
# code is a claim, and this repository has three ways to make a false one.
#
#   1. Tier 6 does not run at all — someone calls `bin/prime` instead of
#      `bin/prime --db`, and the 54 database tests report as `ignored` while
#      the suite still exits 0. darkroom is a service whose entire job is
#      putting bytes in a database.
#   2. Tier 6 runs but touches nothing — `TEST_DATABASE_URL` is unset, every
#      `#[ignore]`d test panics or the harness finds no database, and the run
#      is quietly `0 passed`.
#   3. Tier 5 does not run — `cargo test` does not compile the `s3` feature at
#      all, so the R2 configuration rules and the presigned-URL table are
#      decoration.
#
# None of those change the exit code. All three change the counts, so this
# reads the counts. It is an accounting check, not a second gate: `bin/prime`
# remains the gate, and nothing here loosens it.
#
# ## The invariant worth having
#
# The number of tests the default run *skips* must equal the number the
# database run *passes*. Those are the same set of tests, so the two counts
# agreeing is a real identity and not two numbers that happen to be plausible:
#
#   default `cargo test`      77 passed, 58 ignored
#   `cargo test -- --ignored` 58 passed,  0 ignored
#
# A test that is `#[ignore]`d without the database tier running it breaks the
# identity. A test that is added and never `#[ignore]`d breaks it the other
# way. Neither can reach master as a green badge.
#
# ## The absolute numbers
#
# The floor below is the count on master. It catches the blunter failure — the
# whole integration tree silently ceasing to compile, which would report `0
# passed` everywhere and still balance out. **Adding a test means raising the
# number in the same commit that adds it.** That is the point: the constant is
# a claim someone has to look at, not a number that drifts.
#
# | tier | command | expected |
# |---|---|---|
# | 4 | `cargo test` | 77 lib unit tests, 58 skipped for want of a database, 9 OpenAPI drift checks, 12 tenant-scoping checks, 4 schema-isolation checks |
# | 5 | `cargo test --features s3` | 89 lib unit tests, 9 backend-table rows, 9 OpenAPI drift checks, 12 tenant-scoping checks, 4 schema-isolation checks |
# | 6 | `cargo test -- --ignored` | 58 passed, 7 of them query-scoping, 4 of them schema-isolation |
# | 6 | `cargo test --features s3 -- --ignored` | 58 passed |
#
# The step labels below are the ones `bin/prime` prints. Rewording a step there
# breaks this script, loudly and on the first run, which is the intended
# coupling: the two files must agree about what the tiers are.
#
# ## A test file added in the default tier moves one of these numbers, and
# ## which one is a question, not a matter of taste
#
# The rule above says to raise the number in the same commit. Following that
# literally for `tests/openapi_document.rs` would have meant raising
# `UNIT_TESTS` from 77 — and that would have made the number a lie, because
# `UNIT_TESTS` is counted as `unittests src/lib.rs`, and a new file under
# `tests/` is a *different binary* that `lib.rs`'s count does not include. 77 is
# what `src/lib.rs` holds and it is still 77. The rule's purpose is "the
# constant is a claim someone has to look at", and the way to serve that purpose
# here is to pin the new file in its own right rather than to corrupt a constant
# that means something else.
#
# So the new number is a new constant, and the four existing ones did not move.
# Every one of them is still exactly true, which is checkable and was checked:
#
#   `UNIT_TESTS` and `S3_UNIT_TESTS` count `unittests src/lib.rs`, and this
#     packet added no `#[cfg(test)]` test to the library — `OPERATIONS` in
#     `src/http.rs` is a data table, not a test.
#   `DB_TESTS` is the ignored count, and the new file has **no** `#[ignore]`d
#     test: it needs neither `TEST_DATABASE_URL` nor a socket. It therefore adds
#     0 to the default run's skips and 0 to tier 6's passes, and the identity
#     below stays 41 == 41 at the time it was written.
#   `S3_TABLE_TESTS` is scoped to `tests/storage_backends.rs` and is untouched.
#
# darkroom-09 is the second instance of that pattern, and the one that made the
# pattern worth a paragraph. `tests/tenant_scoping.rs` is another default-tier
# file in none of the four constants, so it is pinned as `TENANT_SCOPE_TESTS`
# for the same reason. It also added 13 `#[ignore]`d tests, so `DB_TESTS` did
# move — 41 to 54 — and the identity below is now 54 == 54. The split is
# exactly the one the rule describes: a default-tier file adds a new constant and
# leaves the others alone; `#[ignore]`d tests move the one constant that counts
# them, and both sides of the identity move together, which is the mechanism
# working rather than two numbers drifting in step by luck.
#
# That last point is the one worth stating plainly, because it is a gap this
# script does **not** cover on its own: every constant above is either scoped to
# a named binary or is a count of `#[ignore]`d tests, and a default-tier
# integration file is neither. If `tests/openapi_document.rs` were emptied, or
# its tests deleted one at a time, every number here would still read correctly
# while the file reported `0 passed`. Pinning it — 9 rows, in the tier where it
# runs — closes that, and is the same mechanism applied to a new file: a
# constant somebody has to look at.
#
# darkroom-hermetic-db-01 is the fourth such file and the first one with tests on
# both sides of the line. `tests/schema_isolation.rs` holds four tests in the
# DEFAULT tier — the shape of a generated schema name, the check on the two
# statements that interpolate one, and the stamp the janitor reads — and four
# `#[ignore]`d ones that need a database. So it adds a new constant of each
# kind, `SCHEMA_ISOLATION_TESTS` and `SCHEMA_ISOLATION_DB_TESTS`, and moves
# `DB_TESTS` 54 -> 58, with both sides of the identity moving together: the
# default run skips 58 and the database run passes 58.
#
# The split is not bookkeeping tidiness. The four default-tier tests are the ones
# that CAN run on a machine with no Postgres, and they are the ones that hold the
# harness's two safety rules — a name that cannot escape an identifier, and a
# `drop schema` that only ever fires on a schema this harness made and that no
# run can still be using. Neither rule is anything to do with isolation levels or
# search paths, so neither should need a database to check, and putting them in
# the database tier would mean the cheapest checks in the tree are the ones a
# developer without Docker never runs.

set -euo pipefail

DB_TESTS=58
UNIT_TESTS=77
S3_UNIT_TESTS=89
S3_TABLE_TESTS=9
# The default-tier integration files are in none of the four above: the first two
# count `unittests src/lib.rs`, the third counts `#[ignore]`d tests, and the
# fourth is scoped to `storage_backends.rs`. So each such file is pinned
# separately, and one that stops running fails the gate instead of quietly
# reporting zero.
OPENAPI_DRIFT_TESTS=9
# `tests/tenant_scoping.rs` is the third such file, and the one this repository
# can least afford to lose silently: it is the only thing in the tree that reads
# `src/store.rs` and holds its `account_id` predicates in place. Delete it and
# every number above still reads correctly while a dropped `and account_id = $2`
# ships green — which is the exact failure darkroom-09 exists to make impossible.
#
# Pinned in BOTH default tiers for the reason `OPENAPI_DRIFT_TESTS` is: the two
# are separate builds of `src/http.rs` and the file reads that source, so a file
# that compiles and runs in one need not in the other.
#
# Twelve. Two are new relative to the first draft of this packet, and both exist
# because that draft was measured rather than trusted:
#
#   `the_operation_kinds_are_what_the_comment_claims` asserts the four-reads,
#   three-lists, two-updates, one-delete breakdown that was previously only
#   prose, and
#   `naming_a_row_is_anchored_to_a_whole_identifier` tests the mutation guard's
#   own predicate, because the unanchored version of it passed a
#   `where account_id = $2` update that rewrites every row an account has.
#
# `the_operation_kinds_are_what_the_comment_claims` deserves its own note. The
# file's headline claim — four reads, three lists, two updates, one delete — was
# prose, and the coverage it describes is exactly what a reader would otherwise
# take on trust. It is also the test that caught the *other* problem in the
# first draft: the sibling assertion compared the derived list of scoped queries
# as a **sequence** against this file's constant, which is grouped by operation
# kind, so it went red on a tree where the two lists held the same ten names in a
# different order. A guard that fails for a reason unrelated to the property gets
# re-run without being read, and one that is habitually red protects nothing. The
# derived side is now sorted, and the grouping is asserted by kind instead.
TENANT_SCOPE_TESTS=12

# `tests/query_scoping.rs` is the only place the query layer is exercised
# against a real Postgres. It is in the `DB_TESTS` total above, which is a count
# of `#[ignore]`d tests across every file — so a file that stopped compiling
# would move that number too. It is pinned separately anyway, for the same
# reason `OPENAPI_DRIFT_TESTS` is: a count that covers several files cannot say
# *which* one went quiet, and for the delete path this is the check that matters
# most. Seven: four operation kinds, the shared-checksum case, the cursor, and
# the sweep.
QUERY_SCOPING_TESTS=7

# `tests/schema_isolation.rs` is the file that holds the per-test schema harness
# in place, and it is the fourth default-tier file this script pins separately —
# pinned in the default tier for `OPENAPI_DRIFT_TESTS`'s reason, because a new
# integration binary is in none of the four constants above.
#
# Four of the eight tests in that file need no database, which is the half that
# matters most: they hold the two rules standing between this harness and a
# `drop schema` of somebody else's table. A name that is only ever
# `t_` + eight lowercase hex characters, and a `drop` that fires only on a schema
# carrying a stamp older than six hours. Neither rule involves Postgres, so both
# are checked on a machine that has none — which is where most runs of this
# repository's default tier happen.
#
# The other four are `#[ignore]`d and are counted in `DB_TESTS` above; pinned
# separately for `QUERY_SCOPING_TESTS`'s reason, since a count that covers seven
# files cannot say which one went quiet.
SCHEMA_ISOLATION_TESTS=4
SCHEMA_ISOLATION_DB_TESTS=4

usage() {
  echo "usage: bin/tier-counts <log-of-'bin/prime --db'>" >&2
  exit 2
}

log="${1:-}"
[[ -n "$log" && -f "$log" ]] || usage

# `bin/prime` prints its step headers through printf with SGR escapes, and
# cargo colours its own output when it thinks it is on a terminal. Neither is
# part of what is being measured, and neither is allowed to change an answer,
# so both are stripped before anything is counted.
clean="$(mktemp)"
trap 'rm -f "$clean"' EXIT
sed -e $'s/\x1b\\[[0-9;]*m//g' "$log" >"$clean"

# Sum `passed` or `ignored` over the `test result:` lines cargo printed,
# optionally restricted to one `==> ` step header and one test binary.
#
# Every binary's result is counted, including the two that are always empty:
# `Running unittests src/main.rs` and the doc-test block. Both contribute zero
# to every total — main.rs has no tests, the crate is `publish = false` and has
# no doctests — so counting them changes no number. Restricting to named
# binaries would hide a file that stopped compiling at all, and "a suite that
# silently stopped running is the failure this script is here to catch" applies
# to a test file exactly as it applies to a test.
count() {
  local scope="${1:-}" pattern="${2:-.*}" field="$3"
  awk -v scope="$scope" -v pattern="$pattern" -v field="$field" '
    /^==>/ { group = $0; sub(/^==> /, "", group) }
    /^ *Running / {
      binary = $0
      sub(/^ *Running /, "", binary)
      sub(/\(.*/, "", binary)
      sub(/ +$/, "", binary)
    }
    /^test result:/ {
      if (scope != "" && group != scope) next
      if (pattern != ".*" && binary !~ pattern) next
      # Cargo writes the count BEFORE the field name — `77 passed;` — so the
      # number is $(i - 1), and the terminator is a semicolon, not a colon.
      # Getting either of those backwards reads every count as zero, which is
      # precisely the failure this script exists to prevent.
      for (i = 1; i <= NF; i++) {
        if ($i == field";") { total += $(i - 1); break }
      }
    }
    END { print total + 0 }
  ' "$clean"
}

fail() {
  printf '\033[1;31m==> tier-counts FAILED\033[0m  %s\n' "$1" >&2
  printf '    %s\n' "$2" >&2
  exit 1
}

expect() {
  local what="$1" got="$2" want="$3"
  if [[ "$got" != "$want" ]]; then
    fail "$what" "expected $want, log says $got"
  fi
  printf '  ok  %-46s %s\n' "$what" "$got"
}

# --- the log is a `--db` run at all ------------------------------------------
# Tier 6 exists only under the flag. A `bin/prime` log is missing its headers,
# and saying so is more useful than reporting a count of zero.
for step in \
  'cargo test (no database)' \
  'cargo test --features s3 (no database)' \
  'cargo test --ignored (against TEST_DATABASE_URL)' \
  'cargo test --features s3 --ignored (against TEST_DATABASE_URL)'
do
  if ! grep -qxF "==> $step" "$clean"; then
    fail "tier ran" "'$step' is not in this log — this is not a complete 'bin/prime --db' run"
  fi
done

# --- tier 4: the default run -------------------------------------------------
# 54 skipped here is not a problem; it is the accounting identity's left side.
expect "tier 4  unit tests" \
  "$(count 'cargo test (no database)' 'unittests src/lib.rs' passed)" "$UNIT_TESTS"
default_ignored="$(count 'cargo test (no database)' '' ignored)"
expect "tier 4  skipped for want of a database" \
  "$default_ignored" "$DB_TESTS"

# The OpenAPI drift check is the file that would have caught a document that
# drifted from the router, so a suite that reports zero here has removed the
# only thing in the repository that notices. Pinned in both default tiers
# because `cargo test` and `cargo test --features s3` are separate builds of
# `src/http.rs` and a file that compiles and runs in one need not in the other.
expect "tier 4  openapi drift checks" \
  "$(count 'cargo test (no database)' 'tests/openapi_document.rs' passed)" "$OPENAPI_DRIFT_TESTS"
expect "tier 4  openapi drift checks left ignored" \
  "$(count 'cargo test (no database)' 'tests/openapi_document.rs' ignored)" "0"

# --- the tenant-scoping file, in the tier that runs it ----------------------
# A file that stops running must fail the gate rather than report zero, and
# "0 passed" is exactly what a deleted security check looks like from outside.
for step in 'cargo test (no database)' 'cargo test --features s3 (no database)'
do
  case "$step" in
    'cargo test (no database)') label='default build' ;;
    *) label='s3 build' ;;
  esac
  expect "tier 4/5  tenant-scoping checks ($label)" \
    "$(count "$step" 'tests/tenant_scoping.rs' passed)" "$TENANT_SCOPE_TESTS"
  expect "tier 4/5  tenant-scoping checks left ignored ($label)" \
    "$(count "$step" 'tests/tenant_scoping.rs' ignored)" "0"
  expect "tier 4/5  schema-isolation checks ($label)" \
    "$(count "$step" 'tests/schema_isolation.rs' passed)" "$SCHEMA_ISOLATION_TESTS"
  # Not zero, and deliberately: this is the only file in the tree whose ignored
  # count is a constant rather than a failure. Half of it needs a database and
  # half does not, so the number that must hold here is the split — a fifth test
  # quietly marked `#[ignore]` would run nowhere, and one quietly un-marked would
  # run on a machine with no Postgres.
  expect "tier 4/5  schema-isolation checks needing a database ($label)" \
    "$(count "$step" 'tests/schema_isolation.rs' ignored)" "$SCHEMA_ISOLATION_DB_TESTS"
done

# --- tier 5: the s3 build ----------------------------------------------------
# `cargo test` does not compile the s3 feature at all, so these two numbers are
# the only evidence darkroom-02's R2 work is still tested by anything.
expect "tier 5  unit tests (s3 build)" \
  "$(count 'cargo test --features s3 (no database)' 'unittests src/lib.rs' passed)" "$S3_UNIT_TESTS"
expect "tier 5  R2/S3 behaviour table rows" \
  "$(count 'cargo test --features s3 (no database)' 'tests/storage_backends.rs' passed)" "$S3_TABLE_TESTS"
expect "tier 5  openapi drift checks (s3 build)" \
  "$(count 'cargo test --features s3 (no database)' 'tests/openapi_document.rs' passed)" "$OPENAPI_DRIFT_TESTS"

# The database tier's own file. `tests/query_scoping.rs` is the only place the
# query layer is exercised against a real Postgres, and the cross-tenant
# behaviour of `store::delete_asset` is proved nowhere else — a service that
# scopes its reads and forgets its delete is the common shape, and an empty
# report here would be a green badge over it.
expect "tier 6  query-scoping cases" \
  "$(count 'cargo test --ignored (against TEST_DATABASE_URL)' 'tests/query_scoping.rs' passed)" "$QUERY_SCOPING_TESTS"
# The other half of `tests/schema_isolation.rs`: the four that genuinely need a
# database, and the four in the default tier this same file runs without one.
# Both numbers, because a harness that stopped isolating would leave the second
# half red and a harness that stopped existing would leave both zero.
expect "tier 6  schema-isolation cases" \
  "$(count 'cargo test --ignored (against TEST_DATABASE_URL)' 'tests/schema_isolation.rs' passed)" "$SCHEMA_ISOLATION_DB_TESTS"
expect "tier 6  schema-isolation cases left ignored" \
  "$(count 'cargo test --ignored (against TEST_DATABASE_URL)' 'tests/schema_isolation.rs' ignored)" "0"

# --- tier 6: the database, both feature sets ---------------------------------
# Two runs, not one. `cargo test -- --ignored` and
# `cargo test --features s3 -- --ignored` are different builds of the library —
# `S3ObjectStore` exists in one and `Config` has a second variant — and the
# checksum table runs against whatever `ObjectStore` is wired, so the
# deployment build has to pass the database tier too.
for label in 'default build' 's3 build'
do
  case "$label" in
    'default build') step='cargo test --ignored (against TEST_DATABASE_URL)' ;;
    's3 build') step='cargo test --features s3 --ignored (against TEST_DATABASE_URL)' ;;
  esac
  expect "tier 6  database tests passed ($label)" \
    "$(count "$step" '' passed)" "$DB_TESTS"
  expect "tier 6  database tests left ignored ($label)" \
    "$(count "$step" '' ignored)" "0"
done

# --- and the identity --------------------------------------------------------
# The only line here that is not a constant-to-constant comparison, and the one
# that would survive the constants being wrong together.
if [[ "$default_ignored" != "$DB_TESTS" ]]; then
  fail "skipped == run" \
    "the default run skipped $default_ignored tests and the database run passed $DB_TESTS; those are the same set and must be the same number"
fi

printf '\n\033[1m==> tier-counts ok\033[0m  %d unit, %d with s3, %d database x2, %d backend-table rows, %d openapi drift x2, %d tenant scoping x2, %d query scoping, %d schema isolation x2\n' \
  "$UNIT_TESTS" "$S3_UNIT_TESTS" "$DB_TESTS" "$S3_TABLE_TESTS" "$OPENAPI_DRIFT_TESTS" \
  "$TENANT_SCOPE_TESTS" "$QUERY_SCOPING_TESTS" "$SCHEMA_ISOLATION_TESTS"
