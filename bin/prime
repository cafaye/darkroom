#!/usr/bin/env bash
# bin/prime — the gate. Everything that must pass before a commit lands.
#
#   ./bin/prime          build, test, clippy, fmt        (no database needed)
#   ./bin/prime --db     the above, plus the database tests against Postgres
#
# `--db` is separate on purpose. The default run is green on a bare machine with
# no Postgres and no Docker, which is what makes it usable as a pre-commit hook.
# The database tests need one, and a skipped test proves nothing — so CI runs
# `--db` and this comment is the reason it is not optional there.
#
# BOTH A CARGO AND A GO TIER, because this repository holds both trees until the
# packet that removes the Rust one, and a gate that runs only the older of two
# implementations is a gate that stopped checking the newer one the day the newer
# one appeared. The Go steps are `gofmt`, `go build`, `go vet`, `go test`; the Go
# database tier needs no separate flag from the Rust one because
# `internal/darkroomdb/pgtest` SKIPS rather than failing when there is no
# database, naming the reason — so a bare `./bin/prime` is honest about what it
# did and did not check, which is what `--db` exists to fix.
set -euo pipefail

cd "$(dirname "$0")/.."

# The gate discipline from PLAN.md §1: a pipeline's exit code is the LAST
# command's, so a failing suite read through a pipe looks like a pass. That is
# exactly how a broken packet reached master once. Every command here runs
# unpiped, and `set -e` is the whole reason this is a script and not a Makefile
# target someone ran with `make -k`.
set -o pipefail

# `./bin/prime --db` is the gate. Tiers 4, 5 and 6, and tier 6 runs the ignored
# database tests IN PARALLEL — each test owns a schema, so there is nothing left
# for `--test-threads=1` to protect. The step headers below are the ones
# `bin/tier-counts` matches on; rewording one breaks that script loudly, which
# is the intended coupling.
step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

step "cargo fmt --check"
cargo fmt --check

step "cargo build"
cargo build --all-targets

step "cargo clippy -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

step "cargo test (no database)"
cargo test

# A third tier, and the reason it exists: `cargo test` above does not compile the
# `s3` feature at all, so the R2 configuration rules, the presigned-URL table
# and the startup refusals are decoration unless something runs them. The
# default build is not enough, and "it compiles" is not "it is tested".
step "cargo test --features s3 (no database)"
cargo test --features s3

# --- the Go rewrite ------------------------------------------------------------
#
# `gofmt -l` rather than `gofmt -w`, and the difference is the whole point: `-w`
# REWRITES the files and exits 0 whatever it found, so a gate built on it reports
# "green" having silently reformatted the commit. `-l` lists and still exits 0, so
# it is paired with an explicit emptiness test. This is the same reasoning as the
# exit-code paragraph at the top of this file, one level down: a check that cannot
# fail is not a check.
step "gofmt -l"
unformatted="$(gofmt -l . 2>/dev/null | grep -v '^\.git/' || true)"
if [[ -n "$unformatted" ]]; then
  echo "    not gofmt-clean:" >&2
  echo "$unformatted" | sed 's/^/      /' >&2
  exit 1
fi

step "go build ./..."
go build ./...

# `go vet` and not `golangci-lint`: a linter is a dependency to version and to
# argue about, and the packet that needs one can add it with a reason. `vet` ships
# with the toolchain and catches the class that matters here — a `Printf` verb
# against a wrong type, which is how this suite's own `pgtype.Text` mistake would
# have reached a commit.
step "go vet ./..."
go vet ./...

# `./...` and NOT `./internal/darkroomdb/...`, which is what this said while
# `darkroomdb` was the only package that had tests. Naming the one package is the
# shape of the bug `AGENTS.md` describes about gates — "A gate that runs only one
# of two implementations stopped checking the other the day the second one
# appeared" — pointed at a package instead of a tree: every package added after
# packet 01 would compile under `go build ./...` and `go vet ./...` and then have
# its tests never run at all. A directory pattern is the version of this step
# that cannot go stale.
#
# The default run still SKIPS the database tests with a named reason rather than
# failing, so this step is honest on a bare machine: the output says which tests
# did not run and why. `go test` discards a passing package's output, so the skip
# rows are invisible without `-v` — which is why the `--db` run below is not
# optional and why this one is not a substitute for it.
step "go test ./... (no database)"
go test ./...

if [[ "${1:-}" == "--db" ]]; then
  # No apostrophes anywhere in this message: bash parses quotes inside the
  # `${VAR:?word}` expansion, so a single apostrophe below — `kit's`, the word
  # this sentence used to contain — turns the whole script into a syntax error
  # at parse time, before a single test runs, and the failure names line 44
  # rather than the mistake. Nothing in this repository's prime run does
  # `bash -n`, so the word is kept out of the string on purpose.
  : "${TEST_DATABASE_URL:?--db needs TEST_DATABASE_URL, e.g. postgres://darkroom:cafaye@localhost:15500/darkroom?sslmode=disable -- that URL is the HOST side of the shared cluster kit ships, so the port is KIT_POSTGRES_PORT (15500), not 5432. See .env.example}"
  step "cargo test --ignored (against TEST_DATABASE_URL)"
  # NO --test-threads=1, and that is the second half of a change whose first half
  # is in `tests/common/mod.rs`: every test now gets a schema of its own, with
  # the migrations applied into it and `truncate` emptying only that schema. The
  # flag was there because the suites shared tables, and the shared tables were
  # the reason. Six parallel runs before that change went red every time, with
  # `NotFound { detail: "asset not found" }` on a test that had created the
  # asset two lines earlier; three after it, green. Four runs are not evidence
  # for a concurrency claim and six are closer, so the counts are in
  # REPORT-darkroom-hermetic-db-01.md rather than here.
  #
  # If a test ever turns out that cannot be isolated, it does NOT get this flag
  # back — that flag is a suite-wide serialisation and re-adding it undoes the
  # isolation for the other fifty. Such a test gets its own `#[ignore]` with a
  # comment saying what it shares with whom, and the count in `bin/tier-counts`
  # moves with it.
  cargo test -- --ignored
  # The same suites with the feature on. It is a different build of the library
  # — `S3ObjectStore` exists, `Config` has a second variant — and the checksum
  # table runs against whatever `ObjectStore` is wired, so it is worth the
  # seconds to know the deployment build still passes the database tier.
  step "cargo test --features s3 --ignored (against TEST_DATABASE_URL)"
  cargo test --features s3 -- --ignored

  # THE GO DATABASE TIER, `-v` BECAUSE `go test` THROWS THE OUTPUT AWAY.
  #
  # This is not a style preference. `go test` discards a passing package's output
  # entirely, so a suite that prints its own `skip:` rows — the honest-skip
  # contract `internal/darkroomdb/pgtest` follows — is INVISIBLE on a green run
  # without `-v`. Pantry records the same measurement in `pgtest_test.go`:
  # "the counters were first incremented inline at each call site and read 6 for a
  # run that entered 12 gates, and the reason was duller than the bug: `go test`
  # DISCARDS a passing package's output entirely."
  #
  # No `--test-threads` equivalent, and there is no Go one to pass: every test
  # owns a schema, which is the same property the Rust tier has and the reason its
  # `--test-threads=1` came out. `pgtest`'s own `TestTheHarnessGivesEachTestItsOwnSchema`
  # holds it rather than assuming it.
  step "go test -v ./internal/darkroomdb/... (against TEST_DATABASE_URL)"
  go test -v -count=1 ./internal/darkroomdb/...
fi

step "ok"
