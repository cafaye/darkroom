# Copy to .env and fill in. Never commit a filled-in copy.
#
# There is no secret in this repository. Object-storage credentials are the AWS
# SDK's own chain (environment, profile, IMDS, container role) and are never
# read from a file this service owns — a credential in a repo file is a
# credential in every clone, every CI log, and every layer of a built image.

# --- required -------------------------------------------------------------

# --- the shared cluster ---------------------------------------------------
#
# darkroom JOINS kit's shared postgres rather than running its own. Its database
# and its NOSUPERUSER role come from ONE key, and that key is named in this
# repository's own `docker-compose.yml` as `${KIT_POSTGRES_DATABASES:-darkroom}`
# — so a single-service checkout needs nothing here and this section can stay
# empty, which is deliberate rather than an oversight.
#
# DO NOT write `KIT_POSTGRES_DATABASES=darkroom` below. Compose gives `.env`
# PRECEDENCE over the `${…:-default}` written in a service's committed compose
# file, so a value here is not a default — it OVERRIDES the committed
# declaration, and the declaration stops being the reviewed, diffable statement
# of what darkroom is. The whole list belongs in ONE place, and this repository's
# compose file is it. Extend it there (comma-separated, alongside the names
# already there) when a second service shares this cluster.
#
# The two keys below are the OPERATOR's, and they are the two that are genuinely
# cluster-wide rather than darkroom's own. kit's `.env.example` documents them
# and ships both with these same defaults, so a value here agrees with kit rather
# than fighting it. A developer who wants postgres somewhere else on their host
# changes `KIT_POSTGRES_PORT` HERE and nowhere else — a variable REPLACES a
# published port, where a `ports:` entry in the service's compose file APPENDS to
# kit's and ends up with two.
KIT_POSTGRES_PORT=15500
KIT_POSTGRES_PASSWORD=cafaye

# This service's own database, from the HOST rather than from inside the compose
# network. It is darkroom's own; there is no shared database and no cross-service
# query.
#
# THREE THINGS CHANGED HERE WHEN THIS SERVICE MOVED ONTO THE SHARED CLUSTER, and
# all three are consequences of kit's defaults rather than choices:
#
#   the port        kit publishes on 15500, not 5432. 5432 was this service's own
#                   container, and `ports:` APPENDS across two compose files, so a
#                   `ports:` block would have left postgres on 15500 AND 5432.
#   the database    `darkroom`, not `darkroom_test`. The init script creates the
#                   database NAMED by its `KIT_POSTGRES_DATABASES` entry.
#   the password    the cluster's, not `darkroom`. Every role the init script
#                   creates takes `POSTGRES_PASSWORD`, so a per-service literal
#                   here is a credential no role holds.
#
# Keep this in step with `DATABASE_URL` in `docker-compose.yml`, which is the same
# pair with `postgres` in place of `localhost`.
DATABASE_URL=postgres://darkroom:cafaye@localhost:15500/darkroom?sslmode=disable

# identity's JWKS. The keys are cached by kid with a bounded TTL and refreshed
# on an unknown kid, so identity is never on the hot path.
DARKROOM_JWKS_URL=https://identity.cafaye.com/.well-known/jwks.json
DARKROOM_ISSUER=https://identity.cafaye.com
DARKROOM_AUDIENCE=darkroom

# --- server ---------------------------------------------------------------

PORT=8080
DARKROOM_BIND_ADDR=0.0.0.0
DARKROOM_DB_MAX_CONNECTIONS=10
DARKROOM_LOG_LEVEL=info
# `json` in production, `human` locally. Defaults to human when stdout is a
# terminal and json otherwise.
# DARKROOM_LOG_FORMAT=json

# `production` unless you are deliberately running against the dev token
# verifier. The HMAC verifier is compiled in behind --features dev-auth AND
# gated on this being `development`, because a feature flag is a build-time
# switch and the environment is the only thing that knows where the binary
# ended up.
DARKROOM_ENV=development

# --- object storage -------------------------------------------------------
#
# `memory` in development: uploads are lost on restart, which is fine, and it
# is the reason a worktree needs no bucket credential to start.
DARKROOM_OBJECT_STORE=memory

# For s3 (the deployment build, --features s3):
# DARKROOM_OBJECT_STORE=s3
# DARKROOM_S3_BUCKET=darkroom-media
# DARKROOM_S3_REGION=us-east-1
# Optional, for an S3-compatible service that is not AWS.
# DARKROOM_S3_ENDPOINT=https://minio.internal:9000
# DARKROOM_S3_PATH_STYLE=true

# For Cloudflare R2 — the same `s3` store, not a different one:
#
#   DARKROOM_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
# DARKROOM_S3_REGION is OPTIONAL here and defaults to `auto`, which is R2's
# region. `us-east-1` and an empty value are accepted (R2 documents them as
# aliases) and are signed as `auto` anyway. Any other region is refused at
# startup, and so is `auto` with no endpoint — AWS has no `auto` region, and a
# bucket-only configuration would otherwise resolve s3.amazonaws.com.
#
# Path-style addressing is forced for an R2 endpoint; DARKROOM_S3_PATH_STYLE has
# no say. Credentials are an R2 API token, read by the AWS SDK's own chain:
# DARKROOM_OBJECT_STORE=s3
# DARKROOM_S3_BUCKET=darkroom-media
# DARKROOM_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
#
# Nothing in darkroom asks the bucket to record a checksum: R2 has no
# FULL_OBJECT SHA-256, so the checksum in the asset row is computed by reading
# the object back at complete time. See README "The storage boundary".

# --- development only -----------------------------------------------------
#
# Only read when DARKROOM_ENV=development and only with --features dev-auth.
# Never set this in a deployed environment: main refuses to start if it is set
# outside development.
# DARKROOM_DEV_JWT_SECRET=change-me

# --- tests ----------------------------------------------------------------
#
# The database integration tests are `#[ignore]`d so `cargo test` is green on a
# bare machine. A skipped test proves nothing, so run them explicitly, against
# the same shared cluster the service uses:
#
#   docker compose --project-directory . \
#     -f <kit>/templates/compose/docker-compose.yml \
#     -f ./docker-compose.yml up -d --wait
#   cargo test -- --ignored --test-threads=1
#
# TEST_DATABASE_URL is the HOST-side URL, so `localhost` and
# `${KIT_POSTGRES_PORT}`, and the same cluster password as `DATABASE_URL` above.
# These tests TRUNCATE the tables they touch, so pointing them at a database that
# holds data you want is how you delete it — see README, "These suites truncate
# the tables they touch."
#
# TEST_DATABASE_URL=postgres://darkroom:cafaye@localhost:15500/darkroom?sslmode=disable
